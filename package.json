{
  "name": "phosphene",
  "productName": "Phosphene",
  "version": "0.1.0",
  "description": "Phosphene \u2014 node-based realtime visual designer, powered by the NERVE engine",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loudensachs/phosphene.git"
  },
  "homepage": "https://github.com/loudensachs/phosphene",
  "keywords": [
    "music-video",
    "visualizer",
    "vj",
    "webgpu",
    "node-editor",
    "electron",
    "datamosh",
    "motion-graphics"
  ],
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "app": "electron .",
    "start": "concurrently -k -n vite,app \"vite\" \"wait-on tcp:5173 && PHOSPHENE_DEV=1 electron .\"",
    "typecheck": "tsc --noEmit",
    "check:wgsl": "tsx scripts/check-wgsl.ts"
  },
  "dependencies": {
    "@fontsource/bodoni-moda": "^5.3.0",
    "@fontsource/fragment-mono": "^5.3.0",
    "@fontsource/instrument-sans": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/michroma": "^5.3.0",
    "@huggingface/transformers": "^4.3.2",
    "@mediapipe/tasks-vision": "^1.2.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@webgpu/types": "^0.1.60",
    "concurrently": "^9.0.0",
    "electron": "^39.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "wait-on": "^8.0.0"
  }
}
